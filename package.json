{
  "name": "setuppilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sets up a private local AI on a Windows PC for complete beginners.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit --noUnusedLocals",
    "demo": "vite --config ui/vite.config.ts",
    "demo:build": "vite build --config ui/vite.config.ts && node tools/check-ui-bundle.cjs",
    "demo:preview": "vite preview --config ui/vite.config.ts",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
